{
	"$schema": "./node_modules/biome/configuration_schema.json",
	"vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true, "defaultBranch": "master" },
	"files": {
		"ignoreUnknown": true,
		"includes": ["**", "!cli.mjs", "!setup.mjs", "!release", "!coverage"]
	},
	"formatter": { "enabled": false },
	"linter": {
		"enabled": true,
		"domains": { "project": "recommended", "test": "recommended", "types": "recommended" },
		"rules": {
			"preset": "recommended",
			"complexity": { "useLiteralKeys": "off" }
		}
	},
	"assist": {
		"actions": {
			"recommended": true,
			"source": { "organizeImports": "off" }
		}
	}
}
