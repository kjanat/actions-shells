{
  "$schema": "https://beepboop.kjanat.dev/schema/v1.json",
  "streams": {
    "actions-shells": {
      "packages": [],
      "versionScope": "one-for-stream",
      "versionSource": {
        "kind": "tags",
        "prefix": "v"
      },
      "mustPublish": [
        "pkg:npm/%40kjanat/actions-shells",
        "workflow:github-packages",
        "workflow:action-release"
      ],
      "promote": {
        "publishWhen": "approved-in-beepboop",
        "workflow": {
          "file": "release.yml",
          "ref": "master",
          "mode": "dispatch",
          "publications": [
            "pkg:npm/%40kjanat/actions-shells",
            "workflow:github-packages",
            "workflow:action-release"
          ]
        }
      },
      "credentials": [
        "npm-token"
      ]
    }
  },
  "managers": [
    "workflow"
  ]
}
