{
	"name": "actions-shells",
	"version": "0.1.0",
	"private": true,
	"description": "More shells for 'run:'. Additional executable languages for GitHub Actions steps",
	"repository": "https://github.com/kjanat/actions-shells",
	"license": "MIT",
	"author": "Kaj Kowalski",
	"type": "module",
	"imports": {
		"#*": "./src/*.ts",
		"#runtimes": "./src/runtimes/index.ts",
		"#pkg": "./package.json"
	},
	"scripts": {
		"build": "tsdown",
		"check": "run -s lint typecheck build test",
		"format": "dprint fmt",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"release:assemble": "pnpm build && node scripts/assemble-release.ts",
		"test": "vitest run",
		"test:integration": "run -s build test:integration:run",
		"test:integration:run": "vitest run test/integration",
		"test:unit": "vitest run test/unit",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@actions/core": "^3",
		"@kjanat/dreamcli": "4.0.0-rc.2",
		"ansispeck": "^0.4.2"
	},
	"devDependencies": {
		"@types/node": "^24",
		"biome": "npm:@biomejs/biome@^2.5",
		"dprint": "^0.57",
		"runner-run": "^0.25",
		"tsdown": "^0.23.0",
		"typescript": "^7",
		"vitest": "^5"
	},
	"engines": {
		"node": "^24"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "24"
		},
		"packageManager": {
			"name": "pnpm",
			"version": "11.25.0"
		}
	},
	"volta": {
		"node": "24.20.0"
	}
}
