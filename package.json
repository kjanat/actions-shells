{
	"name": "@kjanat/actions-shells",
	"version": "0.1.0",
	"description": "More shells for 'run:'. Additional executable languages for GitHub Actions steps",
	"repository": "kjanat/actions-shells",
	"license": "MIT",
	"author": "Kaj Kowalski",
	"type": "module",
	"imports": {
		"#*": "./src/*.ts",
		"#runtimes": "./src/runtimes/index.ts",
		"#pkg": "./package.json"
	},
	"bin": {
		"actions-shell": "./cli.mjs",
		"actions-shells": "./cli.mjs",
		"setup-actions-shells": "./setup.mjs"
	},
	"files": [
		"/*.mjs",
		"/CHANGELOG.md",
		"/SHA256SUMS"
	],
	"scripts": {
		"build": "tsdown",
		"check": "run -s lint typecheck build test",
		"format": "kfmt",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"release:assemble": "pnpm build && node scripts/assemble-release.ts",
		"test": "vitest run",
		"test:integration": "run -s build test:integration:run",
		"test:integration:run": "vitest run test/integration",
		"test:unit": "vitest run test/unit",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@kjanat/fmt": "^0.60.6",
		"@types/node": "^26.6.6",
		"ansispeck": "^0.4.3",
		"biome": "npm:@biomejs/biome@^2.6.7",
		"dreamcli": "npm:@kjanat/dreamcli@^5.0.0",
		"runner-run": "^0.28.0",
		"tsdown": "^0.23.7",
		"typescript": "^7",
		"vitest": "^5.1.0"
	},
	"engines": {
		"node": "^24 || ^26"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "26.13.1"
		},
		"packageManager": {
			"name": "pnpm",
			"version": "12.18.0"
		}
	},
	"volta": {
		"node": "26.13.1"
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://npm.pkg.github.com"
	}
}
